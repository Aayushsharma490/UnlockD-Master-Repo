# Verdant — Environment Configuration Example
# Copy this file to .env for production email reset setup

# Nodemailer Gmail Credentials (Optional fallback logged to console if missing)
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_gmail_app_password

# JWT secret key for signature verification (Overridden in docker-compose.yml for dev)
JWT_SECRET=your_jwt_signing_secret_here
